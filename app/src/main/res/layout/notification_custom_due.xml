<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="#221F1B"
    android:padding="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/notif_app_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="INOUT LEDGER"
            android:textColor="#DEAC64"
            android:textSize="10sp"
            android:textStyle="bold"
            android:letterSpacing="0.1" />

        <TextView
            android:id="@+id/notif_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="DUE ALERT"
            android:textColor="#E57373"
            android:textSize="10sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/notif_party_headline"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="Pay to Lender"
        android:textColor="#F3EFEB"
        android:textSize="15sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/notif_amount_subtext"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="₹ 0.00 • Scheduled for today"
        android:textColor="#A69E94"
        android:textSize="12sp" />
</LinearLayout>
